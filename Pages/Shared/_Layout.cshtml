<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Gabriel Hernán Blanco — FullStack .NET Developer. C#, ASP.NET, SQL Server." />
    <title>@ViewData["Title"] — Gabriel Blanco</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">Gabriel Blanco<span class="ms-2 fw-normal" style="font-size:.8rem;color:var(--text-muted)">| .NET Dev</span></a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Menú">
                    <i class="bi bi-list text-white fs-2"></i>
                </button>
                <div class="collapse navbar-collapse" id="nav">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index" asp-fragment="stack">Stack</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Index" asp-fragment="proyectos">Proyectos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Index" asp-fragment="experiencia">Experiencia</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Index" asp-fragment="contacto">Contacto</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer py-4 mt-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <div class="fw-semibold text-white">&copy; 2026 Gabriel Hernán Blanco</div>
                    <small>FullStack .NET Developer — San Antonio de Padua, AR</small>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <a href="https://github.com/Blan25ga" target="_blank" rel="noopener" class="social-link" aria-label="GitHub"><i class="bi bi-github"></i></a>
                    <a href="https://www.linkedin.com/in/gabrielhernanblanco/" target="_blank" rel="noopener" class="social-link" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    <a href="mailto:blancogabriel751@gmail.com" class="social-link" aria-label="Email"><i class="bi bi-envelope-fill"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
